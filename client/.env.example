# Copy to client/.env
# Google Maps JavaScript API key (enable: Maps JavaScript API + Geocoding API). Without it the app falls back
# to OpenStreetMap previews and manual coordinates, so everything still works in development.
VITE_GOOGLE_MAPS_API_KEY=
# Public Razorpay key id (NOT the secret). Without it the dev "mock checkout" is used when the server is in mock mode.
VITE_RAZORPAY_KEY_ID=
# Only needed if the API is on another origin than the client (production). Leave empty to use the dev proxy / same origin.
VITE_API_URL=
VITE_SOCKET_URL=
