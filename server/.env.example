# Copy to server/.env  (NEVER commit the real .env)
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fixflow
CLIENT_URL=http://localhost:5173

# >= 32 random characters in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Encrypts Aadhaar / certificate files at rest (AES-256-GCM). Keep it safe: losing it makes stored documents unreadable.
DOC_ENCRYPTION_KEY=change-me-to-another-long-random-string-32-chars

# Razorpay - leave empty in development to use the built-in MOCK checkout (same signature verification code path)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

BUSINESS_TZ_OFFSET=+05:30
SWEEPER_INTERVAL_SECONDS=30

# Default admin created on first boot if no admin exists
ADMIN_EMAIL=admin@fixflow.local
ADMIN_PASSWORD=Admin@12345
